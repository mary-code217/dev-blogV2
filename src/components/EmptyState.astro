---
// 글 목록이 비었을 때 쓰는 안내 블록.
// data-state="none"이면 애초에 글이 없는 경우, "filtered"면 필터 결과가 0건인 경우다.
interface Props {
	description: string;
	links: { label: string; href: string }[];
}

const { description, links } = Astro.props;
---

<div class="empty" id="empty-state" data-state="none" hidden>
	<div class="empty__mark" aria-hidden="true">
		<svg viewBox="0 0 84 68" width="84" height="68" fill="none">
			<rect class="frame" x="2" y="2" width="80" height="64" rx="9" />
			<line class="ln ln1" x1="22" y1="26" x2="62" y2="26" />
			<line class="ln ln2" x1="22" y1="36" x2="54" y2="36" />
			<line class="ln ln3" x1="22" y1="46" x2="44" y2="46" />
		</svg>
	</div>

	<div class="empty__body empty__body--none">
		<p class="empty__title">아직 여기에 쌓인 글이 없습니다</p>
		<p class="empty__desc">{description}</p>
		<div class="empty__links">
			{links.map((link, i) => (
				<a class={i === 0 ? 'empty__btn empty__btn--primary' : 'empty__btn'} href={link.href}>
					{link.label}
				</a>
			))}
		</div>
	</div>

	<div class="empty__body empty__body--filtered">
		<p class="empty__title">조건에 맞는 글이 없습니다</p>
		<p class="empty__desc">고른 조건에 걸리는 글이 하나도 없습니다.</p>
		<div class="empty__links">
			<button class="empty__btn empty__btn--primary" type="button" id="empty-reset">
				조건 지우고 전체 보기
			</button>
		</div>
	</div>
</div>

<style>
	.empty {
		flex: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		padding: var(--space-xl) 0;
	}

	.empty[hidden] {
		display: none;
	}

	.empty[data-state='none'] .empty__body--filtered,
	.empty[data-state='filtered'] .empty__body--none {
		display: none;
	}

	.empty__mark {
		margin-bottom: var(--space-md);
		line-height: 0;
	}

	/* 테두리 점선이 한 방향으로 계속 흐른다 */
	.frame {
		stroke: var(--muted);
		stroke-width: 1.5;
		stroke-dasharray: 6 6;
		opacity: 0.5;
		animation: empty-march 3s linear infinite;
	}

	/* 안쪽 줄은 왼쪽부터 차례로 늘어났다가 옅어진다 */
	.ln {
		stroke: var(--muted);
		stroke-width: 2.5;
		stroke-linecap: round;
		opacity: 0;
		transform-box: fill-box;
		transform-origin: left center;
	}

	.ln1 { animation: empty-line 3.6s ease-in-out infinite; }
	.ln2 { animation: empty-line 3.6s ease-in-out 0.35s infinite; }
	.ln3 { animation: empty-line 3.6s ease-in-out 0.7s infinite; }

	@keyframes empty-march {
		to { stroke-dashoffset: -24; }
	}

	@keyframes empty-line {
		0% { opacity: 0; transform: scaleX(0.2); }
		20%, 55% { opacity: 0.4; transform: scaleX(1); }
		75%, 100% { opacity: 0; transform: scaleX(0.2); }
	}

	.empty__title {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.empty__desc {
		margin: var(--space-sm) 0 0 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.empty__links {
		margin-top: var(--space-lg);
		display: flex;
		gap: var(--space-sm);
		flex-wrap: wrap;
		justify-content: center;
	}

	.empty__btn {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap-min-h);
		padding: 0 var(--space-md);
		border: 1px solid var(--border);
		border-radius: 8px;
		background: transparent;
		color: var(--text);
		text-decoration: none;
		font-size: 0.9rem;
		font-family: inherit;
		cursor: pointer;
		transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
	}

	.empty__btn:hover {
		border-color: var(--accent);
		color: var(--accent);
		background: var(--panel);
	}

	.empty__btn--primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
	}

	.empty__btn--primary:hover {
		background: var(--accent);
		border-color: var(--accent);
		color: #fff;
		opacity: 0.88;
	}

	@media (prefers-reduced-motion: reduce) {
		.frame, .ln { animation: none; }
		.ln { opacity: 0.35; transform: none; }
	}
</style>
